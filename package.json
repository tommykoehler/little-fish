{
  "name": "little-fish",
  "version": "0.1.0",
  "private": true,
  "description": "Little Fish splash page",
  "scripts": {
    "dev": "npm run build:css && concurrently --kill-others --names sass,server --prefix-colors magenta,cyan \"npm:watch:css\" \"npm:serve\"",
    "build:css": "sass scss/main.scss css/main.css --no-source-map",
    "watch:css": "sass --watch scss/main.scss css/main.css --no-source-map",
    "serve": "browser-sync start --server --port 3000 --files \"css/*.css\" \"*.html\" \"js/**/*.js\" \"assets/**/*\" --no-notify --no-open --no-ui"
  },
  "devDependencies": {
    "browser-sync": "3.0.4",
    "concurrently": "8.2.2",
    "sass": "1.77.8"
  }
}
